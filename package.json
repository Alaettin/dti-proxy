{
  "name": "dti-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @dti-proxy/server",
    "build": "npm run build --workspace @dti-proxy/web && npm run build --workspace @dti-proxy/server",
    "start": "npm run start --workspace @dti-proxy/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
